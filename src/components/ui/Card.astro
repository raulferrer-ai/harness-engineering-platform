---
/**
 * Tarjeta de contenido: superficie elevada con borde fino.
 * Sin interacción propia; si se necesita enlazar, envuelve un enlace.
 */
interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<div class:list={["rounded-lg border border-line bg-surface p-5", clase]}>
  <slot />
</div>
